<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>EventReader</AssemblyName>
    <RootNamespace>EventReader</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>1591</NoWarn>
    <KoreForgeAppLifecycleDocsTargetRoot>$(MSBuildProjectDirectory)\artifacts\KoreForge.AppLifecycle\</KoreForgeAppLifecycleDocsTargetRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\Scripts.API\**\*.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="KoreForge.Logging" Version="1.1.2" />
    <PackageReference Include="KoreForge.Logging.Serilog" Version="1.1.2" />
    <PackageReference Include="KoreForge.AppLifecycle" Version="1.1.2" />
    <PackageReference Include="KoreForge.Metrics.AspNet" Version="1.1.2" />
    <PackageReference Include="KoreForge.Processing" Version="1.1.2" />
    <PackageReference Include="KoreForge.Settings" Version="1.1.2" />
    <PackageReference Include="KoreForge.Settings.Abstractions" Version="1.1.2" />
    <PackageReference Include="KoreForge.Web.HealthChecks" Version="1.1.2" />
    <PackageReference Include="Confluent.Kafka" Version="2.8.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.4" />
    <PackageReference Include="Microsoft.FASTER.Core" Version="2.6.5" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.0" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Event.Data" VersionOverride="1.1.2" />
    <PackageReference Include="Event.Streaming.Processing" VersionOverride="1.1.2" />
    <PackageReference Include="Event.Streaming.In" VersionOverride="1.1.2" />
    <PackageReference Include="Event.Streaming.Out" VersionOverride="1.1.2" />
    <PackageReference Include="KoreForge.Kafka.Configuration" Version="1.1.2" />
    <PackageReference Include="KoreForge.Kafka.Consumer" Version="1.1.2" />
    <PackageReference Include="KoreForge.Jex" Version="1.1.2" />
    <PackageReference Include="KoreForge.Scripts.Abstractions" Version="1.1.2" />
    <PackageReference Include="KoreForge.Scripts.Core" Version="1.1.2" />
    <PackageReference Include="KoreForge.Scripts.Data" Version="1.1.2" />
    <PackageReference Include="KoreForge.Scripts.AspNet" Version="1.1.2" />
  </ItemGroup>
</Project>