<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>EventReader</AssemblyName>
    <RootNamespace>EventReader</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>1591</NoWarn>
    <KFAppLifecycleDocsTargetRoot>$(MSBuildProjectDirectory)\artifacts\KoreForge.AppLifecycle\</KFAppLifecycleDocsTargetRoot>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Scripts.API\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="KoreForge.Logging.Serilog" Version="0.0.2-alpha" />
    <PackageReference Include="KoreForge.AppLifecycle" Version="0.0.2-alpha" />
    <PackageReference Include="KoreForge.Metrics.AspNet" Version="0.0.2-alpha" />
    <PackageReference Include="KoreForge.Processing" Version="0.0.10-alpha" />
    <PackageReference Include="KoreForge.Settings" Version="0.0.10-alpha" />
    <PackageReference Include="KoreForge.Web.HealthChecks" Version="0.0.3-alpha" />
    <PackageReference Include="Confluent.Kafka" Version="2.8.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.4" />
    <PackageReference Include="Microsoft.FASTER.Core" Version="2.6.5" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Event.Data" VersionOverride="1.0.1-alpha" />
    <PackageReference Include="Event.Streaming.Processing" VersionOverride="1.0.1-alpha" />
    <PackageReference Include="Event.Streaming.In" VersionOverride="1.0.1-alpha" />
    <PackageReference Include="Event.Streaming.Out" VersionOverride="1.0.1-alpha" />
    <PackageReference Include="KF.Kafka.Configuration" VersionOverride="1.0.1-alpha" />
    <PackageReference Include="KF.Kafka.Consumer" VersionOverride="1.0.1-alpha" />
    <PackageReference Include="KoreForge.Jex" VersionOverride="1.0.1-alpha" />
    <PackageReference Include="KF.Logging.Generator" VersionOverride="1.0.1-alpha" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <PackageReference Include="KF.Logging.Analyzers" VersionOverride="1.0.1-alpha" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <PackageReference Include="KoreForge.Scripts.Core" VersionOverride="1.0.1-alpha" />
    <PackageReference Include="KoreForge.Scripts.AspNet" VersionOverride="1.0.1-alpha" />
  </ItemGroup>

</Project>
